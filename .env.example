# String de conexão do MongoDB Atlas (obrigatória para produção no Vercel)
# Crie um cluster gratuito em https://mongodb.com/atlas e cole a connection string aqui
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Credenciais do painel Dev (opcional — padrão: Lucas / Hellen)
DEV_USERNAME=Lucas
DEV_PASSWORD=Hellen

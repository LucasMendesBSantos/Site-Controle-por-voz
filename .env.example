# String de conexão do Vercel Postgres
# No Vercel: Storage → Create Database → Postgres → copie POSTGRES_URL
# Localmente: cole o mesmo valor aqui num arquivo chamado .env
POSTGRES_URL=postgres://<usuario>:<senha>@<host>/<banco>?sslmode=require

# Credenciais do painel Dev (opcional — padrão: Lucas / Hellen)
DEV_USERNAME=Lucas
DEV_PASSWORD=Hellen
